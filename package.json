{
  "name": "doktor-mcp",
  "version": "0.47.1",
  "description": "Source-grounded MCP skeleton for doktor legal information packs.",
  "type": "module",
  "bin": {
    "doktor-mcp": "dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:mcp": "tsx src/mcp/server.ts",
    "mcp": "node dist/mcp/server.js",
    "smoke": "tsx src/cli.ts",
    "smoke:legislation": "tsx src/legislationSmokeCli.ts",
    "smoke:mcp": "tsx src/mcpSmokeCli.ts",
    "smoke:precedents": "tsx src/precedentSmokeCli.ts",
    "probe:precedents": "tsx src/precedentProbeCli.ts",
    "ingest:fixture": "tsx src/ingestFixtureCli.ts",
    "audit:pack": "tsx src/packAuditCli.ts",
    "benchmark:doctor-questions": "tsx src/benchmark/benchmarkRunnerCli.ts",
    "benchmark:doctor-questions:live": "tsx src/benchmark/benchmarkRunnerCli.ts --sourceMode live",
    "benchmark:doctor-questions:live-smoke": "tsx src/benchmark/benchmarkRunnerCli.ts --sourceMode live --limit 5",
    "benchmark:physician-real-world": "tsx src/benchmark/realWorldBenchmarkRunnerCli.ts",
    "benchmark:physician-real-world:live-smoke": "tsx src/benchmark/realWorldLiveSmokeRunnerCli.ts --sourceMode live",
    "benchmark:physician-real-world:live-smoke:mock": "tsx src/benchmark/realWorldLiveSmokeRunnerCli.ts --sourceMode mock",
    "benchmark:doctor-questions:performance": "tsx src/benchmark/performanceBenchmarkCli.ts",
    "cache:warm": "tsx src/cacheWarmCli.ts",
    "verify:health-legislation": "tsx src/verifyHealthLegislationCli.ts",
    "discover:health-legislation-sources": "tsx src/discoverHealthLegislationSourcesCli.ts",
    "verify:discovered-health-legislation": "tsx src/verifyDiscoveredHealthLegislationCli.ts",
    "resolve:health-legislation-rg-leads": "tsx src/resolveHealthLegislationRgLeadsCli.ts",
    "verify:official-gazette-health-legislation": "tsx src/verifyOfficialGazetteHealthLegislationCli.ts",
    "health:sources": "tsx src/sourceHealthCli.ts",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "doctor:diagnose": "tsx src/doctorDiagnoseCli.ts",
    "docs:coverage-matrix": "tsx src/generateCoverageMatrixCli.ts > docs/COVERAGE_MATRIX.md"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pdf-parse": "^2.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^8.57.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
